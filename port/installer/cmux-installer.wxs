<?xml version="1.0" encoding="UTF-8"?>
<!--
    cmux Windows Installer
    Generated for the cmux Windows port (M6 packaging milestone).

    Build requirements:
    - WiX Toolset v3.14+ (candle.exe, light.exe)
    - Built cmux-shell.exe and dependencies in target/release/

    Usage:
    1. Build the port in the release profile from the port/ directory.
    2. Install WiX Toolset v3.14+ (https://github.com/wixtoolset/wix3/releases)
    3. Build: `.\installer\build-installer.ps1` (from port/)

    Code signing (when credentials available):
    - Set SIGNTOOL_PATH and CERT_THUMBPRINT environment variables
    - Or place .pfx file at signing/cert.pfx with CERT_PASSWORD env var
    - The build script signs the produced MSI file after light.exe links it.

    Build variables consumed from candle:
    - SourceDir: this installer/ directory (NOTICES.txt, cmux.json.template)
    - BuildDir:  target/release directory (cmux-shell.exe, conpty.dll,
                 OpenConsole.exe, cmux.exe)
-->

<?ifndef ProductVersion ?>
<?define ProductVersion = "0.0.1" ?>
<?endif?>
<?define ProductName = "cmux" ?>
<?define Manufacturer = "cmux-clone" ?>
<?define UpgradeCode = "{5A3C8F2E-7B4D-4A1F-9E6C-2D8F1A7B3C9D}" ?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="$(var.ProductName)" Language="1033" Version="$(var.ProductVersion)" Manufacturer="$(var.Manufacturer)" UpgradeCode="$(var.UpgradeCode)">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Description="cmux - Ghostty-based Windows terminal with AI agent integration" Comments="cmux Windows port installer" Manufacturer="$(var.Manufacturer)" />

    <!-- Major upgrade handling -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of $(var.ProductName) is already installed." Schedule="afterInstallInitialize" />

    <!-- Media and cabinet -->
    <MediaTemplate EmbedCab="yes" />

    <!-- Features -->
    <Feature Id="MainApplication" Title="cmux Terminal" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="UninstallShortcut" />
    </Feature>

    <!-- UI -->
    <UIRef Id="WixUI_Minimal" />
    <UIRef Id="WixUI_ErrorProgressText" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- Properties. ARPNOMODIFY is set by WixUI_Minimal; declaring it here
         too would duplicate the symbol at link time. -->
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPHELPLINK" Value="https://github.com/AhmedReda-662/cmux-clone" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/AhmedReda-662/cmux-clone" />

    <!-- Installation directory -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="cmux" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="cmux" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <!-- Component Group: Product Files -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <!-- Main executable -->
      <Component Id="CmuxShellApp" Guid="{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}">
        <File Id="CmuxShellExe" Source="$(var.BuildDir)\cmux-shell.exe" KeyPath="yes" Vital="yes" Checksum="yes" />
      </Component>

      <!-- ConPTY bundled runtime -->
      <Component Id="ConPtyRuntime" Guid="{B2C3D4E5-F6A7-8901-BCDE-F12345678901}">
        <File Id="ConPtyDll" Source="$(var.BuildDir)\conpty.dll" KeyPath="yes" Vital="yes" Checksum="yes" />
      </Component>

      <Component Id="OpenConsoleHelper" Guid="{C3D4E5F6-A7B8-9012-CDEF-123456789012}">
        <File Id="OpenConsoleExe" Source="$(var.BuildDir)\OpenConsole.exe" KeyPath="yes" Vital="yes" Checksum="yes" />
      </Component>

      <!-- CLI tool (binary name mirrors upstream's `cmux` CLI surface) -->
      <Component Id="CmuxCliApp" Guid="{D4E5F6A7-B8C9-0123-DEFA-234567890123}">
        <File Id="CmuxCliExe" Source="$(var.BuildDir)\cmux.exe" KeyPath="yes" Vital="yes" Checksum="yes" />
      </Component>

      <!-- Config template (Vital=no: the app generates one if it is missing) -->
      <Component Id="ConfigTemplate" Guid="{E5F6A7B8-C9D0-1234-EFAB-345678901234}">
        <File Id="CmuxJsonTemplate" Source="$(var.SourceDir)\cmux.json.template" KeyPath="yes" Vital="no" />
      </Component>

      <!-- Third-party notices for the shipped binaries (NOT a EULA) -->
      <Component Id="ThirdPartyNotices" Guid="{F6A7B8C9-D0E1-2345-FABC-456789012345}">
        <File Id="NoticesTxt" Source="$(var.SourceDir)\NOTICES.txt" KeyPath="yes" Vital="no" />
      </Component>
    </ComponentGroup>

    <!-- Start Menu shortcuts -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="{1A2B3C4D-5E6F-7890-ABCD-EF1234567891}">
        <Shortcut Id="StartMenuShortcut" Name="cmux" Description="Ghostty-based terminal with AI agent integration" Target="[INSTALLFOLDER]cmux-shell.exe" WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\cmux-clone\cmux" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Desktop shortcut -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="{2B3C4D5E-6F78-9012-ABCD-EF1234567892}">
        <Shortcut Id="DesktopShortcutLink" Name="cmux" Description="Ghostty-based terminal with AI agent integration" Target="[INSTALLFOLDER]cmux-shell.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\cmux-clone\cmux" Name="desktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Uninstall shortcut -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="UninstallShortcut" Guid="{3C4D5E6F-7890-1234-ABCD-EF1234567893}">
        <Shortcut Id="UninstallShortcutLink" Name="Uninstall cmux" Description="Uninstall cmux" Target="[SystemFolder]msiexec.exe" Arguments="/x [ProductCode]" />
        <RegistryValue Root="HKCU" Key="Software\cmux-clone\cmux" Name="uninstallShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Upgrade support: every installed build with a lower version is
         removed before this one installs (major upgrade). -->
    <Upgrade Id="$(var.UpgradeCode)">
      <UpgradeVersion Minimum="0.0.0" Maximum="$(var.ProductVersion)" IncludeMinimum="yes" IncludeMaximum="no" Property="PREVIOUSVERSIONSINSTALLED" />
    </Upgrade>

  </Product>
</Wix>
